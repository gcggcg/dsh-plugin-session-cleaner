{
  "name": "dsh-plugin-session-cleaner",
  "version": "0.1.0",
  "description": "Session cleanup for the DeepSeek Harness Web sidebar: a destructive Delete session action and a per-workspace archived-session visibility toggle.",
  "license": "MIT",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "src/host/*.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "engines": {
    "dsh": ">=0.2.1-rc.3 <0.3.0-0"
  },
  "scripts": {
    "smoke": "node smoke.mjs",
    "test": "node --test \"test/host/*.test.mjs\"",
    "test:host": "node --test \"test/host/*.test.mjs\"",
    "setup:e2e": "node scripts/setup-e2e.mjs",
    "test:e2e": "node test/e2e/run.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-ui-primitives"
      ]
    }
  }
}
