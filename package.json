{
  "name": "@estelle-ge/dsh-plugin-session-cleaner",
  "version": "0.1.2",
  "description": "Session cleanup for the DeepSeek Harness Web sidebar: a destructive Delete session action and a per-workspace archived-session visibility toggle.",
  "license": "MIT",
  "author": "gcggcg",
  "type": "module",
  "main": "index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gcggcg/dsh-plugin-session-cleaner.git"
  },
  "homepage": "https://github.com/gcggcg/dsh-plugin-session-cleaner#readme",
  "bugs": {
    "url": "https://github.com/gcggcg/dsh-plugin-session-cleaner/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "session",
    "delete",
    "archive",
    "sidebar"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "src/host/*.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "engines": {
    "dsh": ">=0.2.1-rc.3 <0.3.0-0"
  },
  "scripts": {
    "smoke": "node smoke.mjs",
    "test": "node --test \"test/host/*.test.mjs\"",
    "test:host": "node --test \"test/host/*.test.mjs\"",
    "setup:e2e": "node scripts/setup-e2e.mjs",
    "test:e2e": "node test/e2e/run.mjs",
    "test:desktop": "node test/e2e/desktop-check.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-ui-primitives"
      ]
    }
  }
}
